# Supabase: Project Settings -> Data API (URL) e API Keys (secret key, sb_secret_...)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_cole-aqui

# Seu e-mail (o mesmo que você vai usar pra criar sua conta). Quem estiver aqui conecta o número do sistema.
ADMIN_EMAIL=seu-email@exemplo.com

TZ=America/Sao_Paulo

# Opcional: se o sistema ficar fora do ar, avisos atrasados mais que isso (minutos) não são enviados
MAX_ATRASO_MIN=720

# Opcional: sugestões de mensagem com IA. Pegue a chave em aistudio.google.com -> Get API key.
# Sem chave, o botão "Sugerir com IA" mostra mensagens prontas.
GEMINI_API_KEY=
# Opcional: força um modelo específico (por padrão tenta uma lista, do mais leve ao mais novo)
# GEMINI_MODELO=

# Opcional: endereço do site usado no convite pra quem não tem conta.
# No Render não precisa: ele usa o endereço do serviço sozinho. Só preencha se tiver domínio próprio.
# SITE_URL=https://lembra.ai

# Planos (opcionais). Preços que aparecem no site e no painel:
# PRECO_MENSAL=9,90
# PRECO_ANUAL=79,90
# Link de pagamento do Premium (ex.: link de assinatura do Asaas). Sem ele, o site diz "pagamento em breve".
# PREMIUM_LINK=https://www.asaas.com/c/xxxxxxxx
